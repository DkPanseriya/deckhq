node_modules/
*.log
*.tgz

# The VS Code extension package, built by `npx @vscode/vsce package` in
# vscode/. Generated from the committed sources; never committed itself.
*.vsix
state.json
state/
.DS_Store
coverage/

# Where the release job — and packaging/README.md's local rehearsal of it —
# renders the manifests and the Windows zip. Generated, never committed.
dist/
stage/
.impeccable/
.claude/settings.local.json

# Captures and diff images from `npm run goldens:check`. The goldens themselves
# (test/goldens/<platform>/*.png) are committed.
test/goldens/.out/

# Whole uncropped frames from `node scripts/site-assets.mjs --survey`, which is
# how a crop rectangle gets chosen. Generated, never committed.
site/.survey/

# Agent worktrees, created by the orchestrator. Never committed.
.claude/worktrees/

# The private planning repository — WP-95b. The blueprint (requirements,
# architecture, specifications, plan, deviations, designer mockups and the hub
# generator) lives in its own git repository mounted here. It is never part of
# the public tree; when it is absent, everything that needs it skips.
/internal/
