{
  "name": "deckhq",
  "version": "1.0.0",
  "description": "Command deck for every agent session on your machine. Claude Code, on one office floor. (Codex adapter included but unverified.)",
  "keywords": [
    "claude-code",
    "codex",
    "agents",
    "dashboard",
    "control-plane",
    "sessions"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "deckhq": "./bin/deckhq.mjs"
  },
  "exports": {
    ".": "./src/daemon.mjs"
  },
  "scripts": {
    "start": "node bin/deckhq.mjs",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs test/unit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "eslint": "^9.13.0",
    "prettier": "^3.3.3"
  }
}
