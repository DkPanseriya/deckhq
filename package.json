{
  "name": "deckhq",
  "version": "1.2.0",
  "description": "Every AI coding session on your machine, on one office floor. It sees the ones your terminal forgot, and remembers what's waiting on you even after you've read it. Local, private, zero dependencies.",
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "ai-agents",
    "agent-management",
    "dashboard",
    "developer-tools",
    "multi-project",
    "sessions",
    "local-first",
    "privacy"
  ],
  "homepage": "https://github.com/DkPanseriya/deckhq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DkPanseriya/deckhq.git"
  },
  "bugs": {
    "url": "https://github.com/DkPanseriya/deckhq/issues"
  },
  "license": "MIT",
  "author": "Darshak Panseriya",
  "funding": "https://github.com/sponsors/DkPanseriya",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "deckhq": "./bin/deckhq.mjs"
  },
  "exports": {
    ".": "./src/daemon.mjs"
  },
  "scripts": {
    "start": "node bin/deckhq.mjs",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs test/unit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "node scripts/demo-floor.mjs",
    "demo:capture": "node scripts/capture-floor.mjs --url http://127.0.0.1:4499/ --width 1600 --height 1000 --settle 8000",
    "prepublishOnly": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "eslint": "^9.13.0",
    "prettier": "^3.3.3"
  }
}
