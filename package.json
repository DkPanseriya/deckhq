{
  "name": "deckhq",
  "version": "1.1.0",
  "description": "Your AI team on one office floor. Manage every Claude Code session across every project from one local, private surface — who is working, who is blocked, who is waiting on you, who is free. (Codex adapter included but unverified.)",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "agent-management",
    "dashboard",
    "developer-tools",
    "multi-project",
    "sessions",
    "control-plane"
  ],
  "homepage": "https://github.com/DkPanseriya/deckhq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DkPanseriya/deckhq.git"
  },
  "bugs": {
    "url": "https://github.com/DkPanseriya/deckhq/issues"
  },
  "license": "MIT",
  "author": "Darshak Panseriya",
  "type": "module",
  "bin": {
    "deckhq": "./bin/deckhq.mjs"
  },
  "exports": {
    ".": "./src/daemon.mjs"
  },
  "scripts": {
    "start": "node bin/deckhq.mjs",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs test/unit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "node scripts/demo-floor.mjs",
    "demo:capture": "node scripts/capture-floor.mjs --url http://127.0.0.1:4499/ --width 1600 --height 1000 --settle 8000"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "eslint": "^9.13.0",
    "prettier": "^3.3.3"
  }
}
