{
  "name": "deckhq",
  "version": "1.7.1",
  "description": "An office for your AI coding agents. DeckHQ puts every Claude Code and Codex session on one office floor and keeps each one in your queue until you clear it. Local, free, MIT, zero dependencies.",
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "gemini-cli",
    "opencode",
    "ai-agents",
    "agent-management",
    "dashboard",
    "developer-tools",
    "multi-project",
    "sessions",
    "local-first",
    "privacy"
  ],
  "homepage": "https://deckhq.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DkPanseriya/deckhq.git"
  },
  "bugs": {
    "url": "https://github.com/DkPanseriya/deckhq/issues"
  },
  "license": "MIT",
  "author": "Darshak Panseriya",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "deckhq": "bin/deckhq.mjs"
  },
  "exports": {
    ".": "./src/daemon.mjs"
  },
  "scripts": {
    "start": "node bin/deckhq.mjs",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs test/unit",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p public/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "node scripts/demo-floor.mjs",
    "demo:capture": "node scripts/capture-floor.mjs --url http://127.0.0.1:4499/ --width 1600 --height 1000 --settle 8000",
    "goldens": "node scripts/goldens.mjs",
    "goldens:check": "node scripts/goldens.mjs --check",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "LICENSE",
    "!public/tsconfig.json"
  ],
  "devDependencies": {
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2"
  }
}
